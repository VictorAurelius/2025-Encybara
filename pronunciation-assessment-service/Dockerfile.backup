# Optimized Dockerfile for WhisperX (CPU-only, fast build)
FROM python:3.10-slim

# Set environment variables
ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1
ENV TZ=Asia/Ho_Chi_Minh
ENV DEBIAN_FRONTEND=noninteractive

# Install only essential system dependencies
RUN echo "[INSTALL] Installing system dependencies..." && \
    apt-get update && \
    apt-get install -y --no-install-recommends \
        curl \
        git \
        ffmpeg \
        build-essential \
        && \
    rm -rf /var/lib/apt/lists/* && \
    echo "[INSTALL] ✓ System dependencies installed"

# Set working directory
WORKDIR /app

# Copy minimal requirements
COPY requirements-minimal.txt ./

# Install base packages from minimal requirements
RUN echo "[INSTALL] Installing base packages..." && \
    pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir -r requirements-minimal.txt && \
    echo "[INSTALL] ✓ Base packages installed"

# Force CPU-only PyTorch installation to avoid CUDA downloads
RUN echo "[INSTALL] Installing PyTorch CPU-only..." && \
    pip install --no-cache-dir \
        torch==2.1.0+cpu \
        torchaudio==2.1.0+cpu \
        --index-url https://download.pytorch.org/whl/cpu && \
    echo "[INSTALL] ✓ PyTorch CPU installed"

# Install transformers and faster-whisper separately
RUN echo "[INSTALL] Installing ML packages..." && \
    pip install --no-cache-dir \
        transformers==4.35.0 \
        faster-whisper==0.10.0 \
        accelerate \
        && \
    echo "[INSTALL] ✓ ML packages installed"

# Install WhisperX last to use existing PyTorch
RUN echo "[INSTALL] Installing WhisperX..." && \
    pip install --no-cache-dir git+https://github.com/m-bain/whisperx.git && \
    echo "[INSTALL] ✓ WhisperX installed"

# Create directories
RUN mkdir -p /app/models /app/temp /app/logs && \
    chmod 777 /app/models /app/temp /app/logs

# Copy application files
COPY . /app/

# Set proper permissions
RUN chmod +x /app/run.py && \
    find /app -name "*.py" -exec chmod +r {} \;

# Create non-root user for security
RUN useradd -m -u 1000 appuser && \
    chown -R appuser:appuser /app
USER appuser

# Expose port
EXPOSE 5000

# Health check with longer timeout for model download on first use
HEALTHCHECK --interval=30s --timeout=60s --start-period=180s --retries=3 \
    CMD curl -f http://localhost:5000/health || exit 1

# Environment variables for WhisperX CPU-only
ENV WHISPERX_DEVICE=cpu
ENV WHISPERX_COMPUTE_TYPE=float32

# Run application - models will download on first use
CMD ["python", "run.py"]