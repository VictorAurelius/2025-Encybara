# Optimized Dockerfile for WhisperX - Minimal dependencies, faster build
FROM python:3.10-slim

# Set environment variables
ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1
ENV TZ=Asia/Ho_Chi_Minh
ENV DEBIAN_FRONTEND=noninteractive

# Install only essential system dependencies
RUN echo "[INSTALL] Installing minimal system dependencies..." && \
    apt-get update && \
    apt-get install -y --no-install-recommends \
        curl \
        git \
        ffmpeg \
        && \
    ln -fs /usr/share/zoneinfo/$TZ /etc/localtime && \
    rm -rf /var/lib/apt/lists/* && \
    echo "[INSTALL] ✓ System dependencies installed"

# Set working directory
WORKDIR /app

# Install minimal Python packages first for faster builds
RUN echo "[INSTALL] Installing base Python packages..." && \
    pip install --no-cache-dir \
        flask==3.0.0 \
        librosa==0.10.1 \
        numpy==1.24.3 \
        scipy==1.11.4 \
        soundfile==0.12.1 \
        werkzeug==3.0.1 \
        gunicorn==21.2.0 \
        psutil==5.9.6 \
        && \
    echo "[INSTALL] ✓ Base packages installed"

# Install PyTorch CPU-only (much smaller)
RUN echo "[INSTALL] Installing PyTorch CPU..." && \
    pip install --no-cache-dir \
        torch==2.1.0+cpu \
        torchaudio==2.1.0+cpu \
        --index-url https://download.pytorch.org/whl/cpu && \
    echo "[INSTALL] ✓ PyTorch CPU installed"

# Install WhisperX and related packages
RUN echo "[INSTALL] Installing WhisperX..." && \
    pip install --no-cache-dir \
        transformers>=4.21.0 \
        faster-whisper>=0.9.0 && \
    pip install --no-cache-dir git+https://github.com/m-bain/whisperx.git && \
    echo "[INSTALL] ✓ WhisperX installed"

# Create directories
RUN mkdir -p /app/models /app/temp /app/logs && \
    chmod 777 /app/models /app/temp /app/logs

# Copy application files
COPY . /app/

# Set proper permissions
RUN chmod +x /app/run.py && \
    find /app -name "*.py" -exec chmod +r {} \;

# Create non-root user
RUN useradd -m -u 1000 appuser && \
    chown -R appuser:appuser /app
USER appuser

# Expose port
EXPOSE 5000

# Health check with longer timeout for model download
HEALTHCHECK --interval=30s --timeout=45s --start-period=120s --retries=3 \
    CMD curl -f http://localhost:5000/health || exit 1

# Environment variables for WhisperX
ENV WHISPERX_DEVICE=cpu
ENV WHISPERX_COMPUTE_TYPE=float32

# Run application - models download on first use
CMD ["python", "run.py"]