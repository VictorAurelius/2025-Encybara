# Simple Dockerfile for WhisperX-based Pronunciation Assessment Service
# This version downloads models at runtime for faster build times
FROM python:3.10-slim

# Set environment variables
ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1

# Set timezone to avoid interactive prompts
ENV TZ=Asia/Ho_Chi_Minh
ENV DEBIAN_FRONTEND=noninteractive

# Install system dependencies
RUN echo "[INSTALL] Installing system dependencies..." && \
    apt-get update && \
    apt-get install -y --no-install-recommends \
        tzdata \
        sox \
        libsox-fmt-all \
        ffmpeg \
        curl \
        git \
        build-essential \
        && \
    ln -fs /usr/share/zoneinfo/$TZ /etc/localtime && \
    dpkg-reconfigure -f noninteractive tzdata && \
    rm -rf /var/lib/apt/lists/* && \
    echo "[INSTALL] ✓ System dependencies installed"

# Set working directory
WORKDIR /app

# Install PyTorch (CPU version for broader compatibility)
RUN echo "[INSTALL] Installing PyTorch..." && \
    pip install --no-cache-dir \
        torch==2.1.0+cpu \
        torchaudio==2.1.0+cpu \
        -f https://download.pytorch.org/whl/torch_stable.html && \
    echo "[INSTALL] ✓ PyTorch installed"

# Copy requirements first for better caching
COPY requirements.txt ./

# Install Python packages
RUN echo "[INSTALL] Installing Python packages..." && \
    pip install --no-cache-dir -r requirements.txt && \
    echo "[INSTALL] ✓ Python packages installed"

# Create directories
RUN mkdir -p /app/models /app/temp /app/logs && \
    chmod 777 /app/models /app/temp /app/logs

# Copy application files
COPY . /app/

# Set proper permissions
RUN chmod +x /app/run.py && \
    find /app -name "*.py" -exec chmod +r {} \;

# Create non-root user for security
RUN useradd -m -u 1000 appuser && \
    chown -R appuser:appuser /app
USER appuser

# Expose port
EXPOSE 5000

# Health check
HEALTHCHECK --interval=30s --timeout=30s --start-period=10s --retries=3 \
    CMD curl -f http://localhost:5000/health || exit 1

# Run application - models will be downloaded on first use
CMD ["python", "run.py"]