# Simple Dockerfile for unreliable networks - Pronunciation Assessment Service
# Use this if the main Dockerfile fails due to network issues

FROM python:3.10-slim

# Set timezone and non-interactive mode
ENV TZ=Asia/Ho_Chi_Minh
ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONUNBUFFERED=1

# Install minimal system dependencies
RUN echo "[INSTALL] Installing minimal dependencies..." && \
    apt-get update && apt-get install -y --no-install-recommends \
    curl \
    && rm -rf /var/lib/apt/lists/* \
    && echo "[INSTALL] ✓ Minimal dependencies installed"

# Set working directory
WORKDIR /app

# Copy requirements and install Python packages
COPY requirements.txt requirements-py313.txt ./
RUN echo "[INSTALL] Installing Python packages..." && \
    pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir -r requirements.txt \
    && echo "[INSTALL] ✓ Python packages installed"

# Copy application files
COPY . /app/

# Create necessary directories
RUN mkdir -p /app/temp /app/logs && \
    chmod 777 /app/temp /app/logs

# Expose port
EXPOSE 5000

# Health check
HEALTHCHECK --interval=30s --timeout=30s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:5000/health || exit 1

# Run application
CMD ["python", "app.py"]