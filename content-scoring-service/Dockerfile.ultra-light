# Ultra-lightweight Content Scoring Service
# Build time: ~60s instead of 4000s

FROM python:3.10-slim

# Set environment variables
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app

# Install only curl for health checks
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Create app directory
WORKDIR /app

# Copy and install ultra-light requirements
COPY requirements.ultra-light.txt .
RUN pip install --no-cache-dir -r requirements.ultra-light.txt

# Download minimal NLTK data
RUN python -c "import nltk; nltk.download('punkt', quiet=True); nltk.download('stopwords', quiet=True)" 2>/dev/null || true

# Create non-root user
RUN groupadd -r appuser && useradd -r -g appuser appuser

# Copy application code
COPY simple_scoring_app.py ./
RUN mkdir -p app

# Create app structure
RUN cp simple_scoring_app.py app/main.py && \
    echo "from simple_scoring_app import app" > app/__init__.py

# Set permissions
RUN chown -R appuser:appuser /app

# Switch to non-root user
USER appuser

# Expose port
EXPOSE 5001

# Health check with faster timing
HEALTHCHECK --interval=15s --timeout=5s --start-period=10s --retries=2 \
    CMD curl -f http://localhost:5001/health || exit 1

# Start service
CMD ["python", "/app/simple_scoring_app.py"]