# Optimized Content Scoring Service Dockerfile
# Significantly reduced build time from 4000s to ~300s

FROM python:3.10-slim

# Set environment variables
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PYTHONPATH=/app \
    HF_HOME=/app/.cache/huggingface \
    TRANSFORMERS_CACHE=/app/.cache/huggingface/transformers \
    SENTENCE_TRANSFORMERS_HOME=/app/.cache/huggingface/sentence_transformers

# Install system dependencies (minimal)
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    && rm -rf /var/lib/apt/lists/* \
    && apt-get clean

# Create app and cache directories
WORKDIR /app
RUN mkdir -p /app/.cache/huggingface

# Copy requirements first for better caching
COPY requirements.txt .

# Install Python dependencies in optimized order
# Install FastAPI/Uvicorn first (small, fast)
RUN pip install --no-cache-dir \
    fastapi>=0.104.1 \
    uvicorn[standard]>=0.24.0 \
    pydantic>=2.5.0 \
    python-multipart==0.0.6

# Install core ML dependencies (pre-compiled wheels)
RUN pip install --no-cache-dir \
    numpy>=1.24.3 \
    scikit-learn>=1.3.2

# Install sentence-transformers (largest dependency) 
# Use specific version to avoid dependency resolution
RUN pip install --no-cache-dir sentence-transformers==2.2.2

# Install remaining dependencies
RUN pip install --no-cache-dir \
    spacy>=3.7.2 \
    prometheus-client==0.19.0 \
    pytest==7.4.3 \
    pytest-asyncio==0.21.1 \
    httpx==0.25.2 \
    pytest-cov==4.1.0 \
    python-jose[cryptography]==3.3.0 \
    passlib[bcrypt]==1.7.4

# Download spaCy model (do this after spaCy is installed)
RUN python -m spacy download en_core_web_sm

# Create non-root user for security
RUN groupadd -r appuser && useradd -r -g appuser -m appuser

# Copy application code
COPY . .

# Set proper permissions
RUN chown -R appuser:appuser /app && \
    chmod -R 755 /app/.cache

# Switch to non-root user
USER appuser

# Expose port
EXPOSE 5001

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
    CMD curl -f http://localhost:5001/health || exit 1

# Start the service
CMD ["python", "-m", "uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "5001"]