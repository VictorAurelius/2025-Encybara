# Ultra-fast Dockerfile - NO ML libraries (under 1 minute build)
FROM python:3.10-slim

# Set working directory
WORKDIR /app

# Set environment variables for fastest builds
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    ML_ENABLED=false

# Install system dependencies (minimal)
RUN apt-get update && apt-get install -y \
    curl \
    && rm -rf /var/lib/apt/lists/* \
    && apt-get clean

# Upgrade pip
RUN pip install --upgrade pip

# Copy and install ultra-minimal requirements (NO ML libraries)
COPY requirements-ultra-minimal.txt .
RUN pip install --prefer-binary -r requirements-ultra-minimal.txt

# Copy startup script and make executable
COPY scripts/docker-entrypoint-ultra-fast.sh ./scripts/
RUN chmod +x ./scripts/docker-entrypoint-ultra-fast.sh

# Copy application code
COPY app/ ./app/

# Create non-root user for security
RUN groupadd -r appuser && useradd -r -g appuser appuser && \
    chown -R appuser:appuser /app
USER appuser

# Expose port
EXPOSE 5001

# Health check (simplified)
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=2 \
    CMD curl -f http://localhost:5001/health || exit 1

# Run the application
CMD ["./scripts/docker-entrypoint-ultra-fast.sh"]